/*
 * Conformance: the round-trip guard. `email` declares no secret-classified
 * option, so nothing here is hashed at rest and the harness re-applies the
 * forma that Extract produced. Every other contact point case carries a
 * secret-classified option and is skipped for that check, because re-applying
 * a hashed value is refused at the plugin write boundary by design.
 *
 * Keep this case secret-free: adding a secret-classified option - a `url`, a
 * `token`, a `password` - would silently drop the only Extract re-apply
 * coverage a contact point has.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@grafana/alerting/contact_point.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local stackName = "plugin-sdk-test-stack"

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK conformance test stack"
  }

  new formae.Target {
    label = "grafana-target"
    namespace = "GRAFANA"
    config = new Mapping {
      ["Type"] = "Grafana"
      ["Url"] = read("env:GRAFANA_URL")
    }
  }

  new contact_point.ContactPoint {
    label = "test-contact-point"
    uid = "formae-test-\(testRunID)"
    name = "Formae Test ContactPoint \(testRunID)"
    contactPointType = "email"
    settings = new {
      addresses = "formae-test@example.com"
      singleEmail = true
    }
  }
}
