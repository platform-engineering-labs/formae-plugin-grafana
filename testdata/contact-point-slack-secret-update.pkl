/*
 * Conformance: update path for a contact point carrying a Grafana-secret value.
 * Changes only the non-secret `recipient`, so the update must be reported
 * without the secret `url` reappearing in state, and must not diff against the
 * "[REDACTED]" value Grafana returns for it.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@grafana/alerting/contact_point.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local stackName = "plugin-sdk-test-stack"

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK conformance test stack"
  }

  new formae.Target {
    label = "grafana-target"
    namespace = "GRAFANA"
    config = new Mapping {
      ["Type"] = "Grafana"
      ["Url"] = read("env:GRAFANA_URL")
    }
  }

  new contact_point.ContactPoint {
    label = "test-contact-point-slack-secret"
    uid = "formae-test-slacksecret-\(testRunID)"
    name = "Formae Test Slack Secret \(testRunID)"
    contactPointType = "slack"
    settingsMap = new Mapping {
      ["url"] = "https://hooks.slack.com/services/T00000000/B00000000/formaeConformance"
      ["recipient"] = "#formae-test-updated"
    }
  }
}
