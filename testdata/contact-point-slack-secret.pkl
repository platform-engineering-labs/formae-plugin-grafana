/*
 * Conformance: a contact point whose settings carry a value Grafana treats as
 * secret (the Slack `url`). Grafana stores such fields encrypted and returns
 * them as the literal "[REDACTED]" on every read path, so this case exercises
 * the plugin against a value that can never be read back as submitted.
 *
 * A secret-classified option is hashed at rest, so this case is skipped for
 * the Extract re-apply check; contact-point.pkl is the round-trip guard.
 */
amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@grafana/alerting/contact_point.pkl"

local testRunID = read("env:FORMAE_TEST_RUN_ID")
local stackName = "plugin-sdk-test-stack"

forma {
  new formae.Stack {
    label = stackName
    description = "Plugin SDK conformance test stack"
  }

  new formae.Target {
    label = "grafana-target"
    namespace = "GRAFANA"
    config = new Mapping {
      ["Type"] = "Grafana"
      ["Url"] = read("env:GRAFANA_URL")
    }
  }

  new contact_point.ContactPoint {
    label = "test-contact-point-slack-secret"
    uid = "formae-test-slacksecret-\(testRunID)"
    name = "Formae Test Slack Secret \(testRunID)"
    contactPointType = "slack"
    settings = new {
      url = "https://hooks.slack.com/services/T00000000/B00000000/formaeConformance"
      recipient = "#formae-test"
    }
  }
}
