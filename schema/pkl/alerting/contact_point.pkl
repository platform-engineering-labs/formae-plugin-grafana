/// Grafana contact point resource.
module alerting.contact_point

import "@formae/formae.pkl"
import "generated/contact_point_settings.pkl"

const type = "GRAFANA::Alerting::ContactPoint"

/// Resolvable reference to a ContactPoint.
open class ContactPointResolvable extends formae.Resolvable {
  hidden type = module.type

  /// The contact point's name. This is the handle downstream resources use to
  /// refer to a contact point - notably `NotificationPolicy.receiver`, which
  /// Grafana matches by name rather than by uid.
  hidden name: ContactPointResolvable = (this) {
    property = "name"
  }
}

/// A Grafana alerting contact point (notification channel).
/// Supports email, Slack, PagerDuty, webhook, and many other integrations.
@formae.ResourceHint {
  type = "GRAFANA::Alerting::ContactPoint"
  identifier = "$.uid"
}
class ContactPoint extends formae.Resource {
  fixed hidden type: String = "GRAFANA::Alerting::ContactPoint"

  /// Unique identifier. Auto-generated by Grafana.
  @formae.FieldHint { createOnly = true }
  uid: String?

  /// Display name of the contact point.
  /// Cannot be changed after creation (TF `grafana_contact_point.name` is
  /// `ForceNew: true`; the name is the stable handle used by downstream
  /// references such as `NotificationPolicy.receiver`).
  @formae.FieldHint { createOnly = true }
  name: String

  /// Contact point type (e.g., "email", "slack", "pagerduty", "webhook").
  @formae.FieldHint { createOnly = true }
  contactPointType: String

  /// Type-specific settings: one typed object whose keys are the options the
  /// declared `contactPointType` accepts. Every option any notifier type
  /// declares is available as an optional property, so an option no notifier
  /// declares - a misspelled key - is a Pkl type error. An option that belongs
  /// to a different notifier type than the one declared still evaluates here;
  /// the plugin rejects it when the contact point is submitted.
  /// Nested blocks (a webhook's `http_config.oauth2.tls_config`,
  /// an OpsGenie `responders` entry) are typed objects of their own, and every
  /// free-text option accepts a `formae.Resolvable`, which lets cross-plugin
  /// wiring stay in a single apply:
  ///
  ///   settings = new {
  ///     integrationKey = pdIntegration.res.integrationKey
  ///     severity = "critical"
  ///   }
  ///
  /// Options Grafana classifies as secret - a Slack `url` or `token`, a
  /// PagerDuty `integrationKey`, a webhook `password` - additionally accept a
  /// `formae.SecretValue`. Those are hashed at rest and never read back:
  /// Grafana stores them encrypted and returns the literal `[REDACTED]` on
  /// every read, so the plugin declines to report a value it cannot observe
  /// and formae keeps the declared one. That is a deliberate loss of
  /// observability - a secret rotated, replaced or removed outside formae
  /// cannot be detected, so reconciling a suspected divergence means
  /// re-applying the declared value rather than syncing Grafana's. Every
  /// non-secret key is drift-checked individually, so an out-of-band edit to
  /// one setting is reported as a change to that key alone.
  @formae.FieldHint {}
  settings: contact_point_settings.ContactPointSettings?

  /// Whether to disable sending resolve notifications.
  @formae.FieldHint {}
  disableResolveMessage: Boolean = false

  local parent = this

  hidden res: ContactPointResolvable = new {
    label = parent.label
    stack = parent.stack?.label
  }
}
